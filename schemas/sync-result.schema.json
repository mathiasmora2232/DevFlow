{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevFlow Sync Result",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "devflow_version",
    "status",
    "changes",
    "conflicts",
    "timestamp"
  ],
  "properties": {
    "schema": {
      "const": "devflow.sync-result"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "clean",
        "changed",
        "conflict",
        "partial",
        "failed"
      ]
    },
    "changes": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "source_versions": {
      "type": "object"
    },
    "timestamp": {
      "type": "string"
    },
    "devflow_version": {
      "type": "string"
    }
  }
}
