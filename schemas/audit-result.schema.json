{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevFlow Audit Result",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "devflow_version",
    "project_health_score",
    "stack_fit_score",
    "evidence_confidence",
    "categories",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "devflow.audit"
    },
    "schema_version": {
      "const": 1
    },
    "devflow_version": {
      "type": "string"
    },
    "project_health_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "stack_fit_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "evidence_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "categories": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "finding_reconciliation": {
      "type": "object"
    },
    "unknowns": {
      "type": "array"
    }
  }
}
